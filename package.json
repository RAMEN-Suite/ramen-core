{
  "name": "@ramen-suite/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.3.0 <27",
    "npm": ">=11.16.0 <12"
  },
  "packageManager": "npm@11.16.0",
  "license": "MIT",
  "description": "JSON model format and modelling kernel for the RAMEN suite",
  "sideEffects": false,
  "files": [
    "dist/ramen-core"
  ],
  "exports": {
    ".": {
      "types": "./dist/ramen-core/index.d.ts",
      "default": "./dist/ramen-core/index.js"
    },
    "./model": {
      "types": "./dist/ramen-core/model/index.d.ts",
      "default": "./dist/ramen-core/model/index.js"
    },
    "./ramen": {
      "types": "./dist/ramen-core/ramen/index.d.ts",
      "default": "./dist/ramen-core/ramen/index.js"
    },
    "./schemas/*": {
      "default": "./dist/ramen-core/schemas/*"
    }
  },
  "scripts": {
    "build": "npm run build:types && npm run build:bundle && npm run build:package",
    "build:bundle": "esbuild src/index.ts src/model/index.ts src/ramen/index.ts --bundle --format=esm --platform=neutral --outdir=dist/ramen-core --outbase=src --external:json-schema-library --external:short-unique-id",
    "build:package": "node --experimental-strip-types tools/package.ts",
    "build:types": "tsc -p tsconfig.json",
    "docs:build": "npm run docs:diagnostics && node --experimental-strip-types ./node_modules/typedoc/bin/typedoc",
    "docs:diagnostics": "node --experimental-strip-types tools/generate-diagnostics.ts",
    "docs:diagnostics:check": "node --experimental-strip-types tools/generate-diagnostics.ts --check",
    "docs:serve": "npm run docs:build && concurrently --kill-others --names docs,server \"npm run docs:watch\" \"http-server dist/api-doc -a 127.0.0.1 -p 5173 -c-1\"",
    "docs:watch": "node --experimental-strip-types ./node_modules/typedoc/bin/typedoc --watch --preserveWatchOutput",
    "format": "prettier --check . --ignore-unknown",
    "format:fix": "prettier --write . --ignore-unknown",
    "lint": "eslint src test tools",
    "lint:fix": "eslint src test tools --fix",
    "package:check": "node --experimental-strip-types tools/check-package.ts",
    "prepare": "git config core.hooksPath .githooks",
    "schema:check": "node --experimental-strip-types tools/generate-schema.ts --check",
    "schema:generate": "node --experimental-strip-types tools/generate-schema.ts",
    "test": "npm run typecheck:tests && node --experimental-strip-types --test test/**/*.test.ts",
    "test:coverage": "npm run build && npm run typecheck:tests && node --experimental-strip-types --experimental-test-coverage --test-coverage-include='dist/ramen-core/**/*.js' --test test/**/*.test.ts",
    "test:watch": "npm run typecheck:tests && node --experimental-strip-types --test --watch test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "verify": "npm run typecheck:tools && npm run schema:check && npm run build && npm run lint && npm run docs:diagnostics:check && npm run format && npm test && npm run docs:build && npm run package:check"
  },
  "dependencies": {
    "json-schema-library": "11.4.0",
    "short-unique-id": "^5.3.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "concurrently": "^10.0.5",
    "esbuild": "^0.25.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "http-server": "^14.1.1",
    "prettier": "^3.9.6",
    "typedoc": "^0.28.20",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "author": {
    "name": "Sebastian Enns",
    "email": "mail@sebenns.com"
  },
  "keywords": [
    "ramen",
    "modelling",
    "metamodelling",
    "json-schema",
    "validation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RAMEN-Suite/ramen-core.git"
  },
  "homepage": "https://github.com/RAMEN-Suite/ramen-core#readme",
  "bugs": {
    "url": "https://github.com/RAMEN-Suite/ramen-core/issues"
  }
}
