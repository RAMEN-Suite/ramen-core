{
  "name": "@ramen-suite/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "JSON model format and modelling kernel for the RAMEN suite",
  "sideEffects": false,
  "files": [
    "dist/ramen-core"
  ],
  "exports": {
    ".": {
      "types": "./dist/ramen-core/index.d.ts",
      "default": "./dist/ramen-core/index.js"
    },
    "./model": {
      "types": "./dist/ramen-core/model/index.d.ts",
      "default": "./dist/ramen-core/model/index.js"
    },
    "./ramen": {
      "types": "./dist/ramen-core/ramen/index.d.ts",
      "default": "./dist/ramen-core/ramen/index.js"
    }
  },
  "scripts": {
    "build": "npm run clean:core && npm run build:types && npm run build:bundle",
    "build:bundle": "esbuild src/index.ts src/model/index.ts src/ramen/index.ts --bundle --format=esm --platform=neutral --outdir=dist/ramen-core --outbase=src --external:json-schema-library --external:short-unique-id",
    "build:types": "tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "clean:core": "node scripts/clean.mjs core",
    "docs:build": "typedoc",
    "docs:serve": "npm run docs:build && concurrently --kill-others --names docs,server \"npm run docs:watch\" \"http-server dist/api-doc -a 127.0.0.1 -p 5173 -c-1\"",
    "docs:watch": "typedoc --watch --preserveWatchOutput",
    "examples:check": "tsc -p tsconfig.examples.json --noEmit && node scripts/check-examples.mjs",
    "format": "prettier --check . --ignore-unknown",
    "format:fix": "prettier --write . --ignore-unknown",
    "lint": "eslint src test examples scripts",
    "lint:fix": "eslint src test examples scripts --fix",
    "package:check": "npm pack --dry-run --ignore-scripts",
    "prepare": "husky",
    "schema:check": "node scripts/generate-ramen-project-schema.mjs --check",
    "schema:generate": "node scripts/generate-ramen-project-schema.mjs",
    "test": "npm run typecheck:tests && node --experimental-strip-types --test test/**/*.test.ts",
    "test:coverage": "npm run build && npm run typecheck:tests && node --experimental-strip-types --experimental-test-coverage --test-coverage-include='dist/ramen-core/**/*.js' --test test/**/*.test.ts",
    "test:watch": "npm run typecheck:tests && node --experimental-strip-types --test --watch test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "verify": "npm run schema:check && npm run build && npm run lint && npm run format && npm run examples:check && npm test && npm run docs:build && npm run package:check"
  },
  "dependencies": {
    "json-schema-library": "^11.0.4",
    "short-unique-id": "^5.3.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "concurrently": "^10.0.5",
    "esbuild": "^0.25.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typedoc": "^0.28.20",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "author": {
    "name": "Sebastian Enns",
    "email": "mail@sebenns.com"
  }
}
