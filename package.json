{
  "name": "@ramen-suite/core",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "npm@11.16.0",
  "license": "MIT",
  "description": "TypeScript library for creating, refining, validating and exchanging RMF and RAMEN data models",
  "sideEffects": false,
  "files": [
    "dist/ramen-core/index.js",
    "dist/ramen-core/index.d.ts",
    "dist/ramen-core/model",
    "dist/ramen-core/ramen",
    "dist/ramen-core/schemas"
  ],
  "exports": {
    ".": {
      "types": "./dist/ramen-core/index.d.ts",
      "default": "./dist/ramen-core/index.js"
    },
    "./model": {
      "types": "./dist/ramen-core/model/index.d.ts",
      "default": "./dist/ramen-core/model/index.js"
    },
    "./ramen": {
      "types": "./dist/ramen-core/ramen/index.d.ts",
      "default": "./dist/ramen-core/ramen/index.js"
    },
    "./schemas/*": {
      "default": "./dist/ramen-core/schemas/*"
    }
  },
  "scripts": {
    "build": "node tools/clean-build.ts && tsc && esbuild \"src/**/*.ts\" --bundle --external:*.js --format=esm --platform=neutral --outdir=dist/ramen-core --outbase=src --packages=external && node tools/copy-schemas.ts",
    "docs:build": "npm run docs:diagnostics && typedoc",
    "docs:diagnostics": "node tools/generate-diagnostics.ts",
    "docs:diagnostics:check": "node tools/generate-diagnostics.ts --check",
    "docs:serve": "npm run docs:build && http-server dist/api-doc -a 127.0.0.1 -p 5173 -c-1",
    "docs:watch": "typedoc --watch --preserveWatchOutput",
    "format": "prettier --check . --ignore-unknown",
    "format:fix": "prettier --write . --ignore-unknown",
    "lint": "eslint src test tools",
    "lint:fix": "eslint src test tools --fix",
    "package:check": "npm run build && node tools/check-package.ts",
    "prepare": "git config core.hooksPath .githooks",
    "schema:check": "node tools/generate-schema.ts --check",
    "schema:generate": "node tools/generate-schema.ts",
    "test": "npm run build && npm run typecheck && node --test \"test/**/*.test.ts\"",
    "test:coverage": "npm run build && npm run typecheck && node --experimental-test-coverage --test-coverage-include=\"dist/ramen-core/**/*.js\" --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.tools.json",
    "verify": "npm run schema:check && npm run docs:diagnostics:check && npm run lint && npm run format && npm test && npm run docs:build && node tools/check-package.ts"
  },
  "dependencies": {
    "json-schema-library": "11.4.0",
    "short-unique-id": "^5.3.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "esbuild": "^0.25.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "http-server": "^14.1.1",
    "prettier": "^3.9.6",
    "typedoc": "^0.28.20",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "author": {
    "name": "Sebastian Enns",
    "email": "mail@sebenns.com"
  },
  "keywords": [
    "ramen",
    "modelling",
    "metamodelling",
    "json-schema",
    "validation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RAMEN-Suite/ramen-core.git"
  },
  "homepage": "https://github.com/RAMEN-Suite/ramen-core#readme",
  "bugs": {
    "url": "https://github.com/RAMEN-Suite/ramen-core/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
