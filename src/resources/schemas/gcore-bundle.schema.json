{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ramen-schema.org/gcore/1.0.0/bundle.json",
  "title": "GCore model bundle",
  "description": "Portable envelope for a complete GCore project. Each entry in models is additionally validated against the versioned GCore model schema.",
  "type": "object",
  "required": ["$schema", "kind", "version", "rootModelId", "models"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "https://ramen-schema.org/gcore/1.0.0/bundle.json" },
    "kind": { "const": "GModelBundle" },
    "version": { "const": "1.0.0" },
    "rootModelId": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "minLength": 16 },
    "models": { "type": "array", "minItems": 1, "items": { "type": "object" } }
  }
}
