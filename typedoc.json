{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/model/index.ts", "src/ramen/index.ts"],
  "tsconfig": "tsconfig.json",
  "out": "dist/api-doc",
  "name": "RAMEN Core",
  "plugin": ["./tools/typedoc-router.ts"],
  "router": "guides",
  "readme": "docs/rmf/rmf.md",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "disableSources": true,
  "projectDocuments": [
    "docs/rmf/rmf.md",
    "docs/constraint-languages.md",
    "docs/rmf/inheritance.md",
    "docs/rmf/suggestions.md",
    "docs/rmf/validation.md",
    "docs/rmf/exchange.md",
    "docs/rmf/model-changes.md",
    "docs/ramen/ramen.md",
    "docs/examples/website.md",
    "docs/examples/correspondence-edition.md"
  ],
  "sortEntryPoints": false,
  "groupOrder": ["RMF", "RAMEN", "Examples", "Modules", "*"],
  "navigation": {
    "includeGroups": true
  },
  "customCss": "docs/style.css"
}
