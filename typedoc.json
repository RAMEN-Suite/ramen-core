{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/model/index.ts", "src/ramen/index.ts"],
  "tsconfig": "tsconfig.json",
  "out": "dist/api-doc",
  "name": "RAMEN Core",
  "readme": "docs/rmf/rmf.md",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "disableSources": true,
  "projectDocuments": [
    "docs/rmf/rmf.md",
    "docs/constraint-languages.md",
    "docs/rmf/inheritance.md",
    "docs/rmf/suggestions.md",
    "docs/rmf/validation.md",
    "docs/rmf/exchange.md",
    "docs/ramen/ramen.md",
    "docs/ramen/data-types.md",
    "docs/ramen/annotations.md",
    "docs/ramen/validation.md",
    "docs/ramen/export.md",
    "docs/glossary.md"
  ],
  "sortEntryPoints": false,
  "groupOrder": ["RMF", "RAMEN", "Modules", "*"],
  "navigation": {
    "includeGroups": true
  },
  "customCss": "docs/style.css"
}
