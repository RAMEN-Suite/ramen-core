{
  "entryPoints": ["src"],
  "entryPointStrategy": "expand",
  "out": "api-docs",
  "excludeInternal": true,
  "readme": "none",
  "githubPages": false,
  "categorizeByGroup": true,
  "disableGit": true,
  "disableSources": true,
  "requiredToBeDocumented": ["Class", "Interface", "Function", "Method", "TypeAlias", "Variable"],
  "validation": {
    "notDocumented": true
  },
  "treatValidationWarningsAsErrors": true,
  "treatWarningsAsErrors": true
}
