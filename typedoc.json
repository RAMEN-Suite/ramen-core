{
  "entryPoints": ["src/index.ts", "src/model/index.ts", "src/ramen/index.ts"],
  "entryPointStrategy": "resolve",
  "out": "api-docs",
  "excludeInternal": true,
  "readme": "README.md",
  "githubPages": false,
  "categorizeByGroup": true,
  "disableGit": true,
  "disableSources": true,
  "requiredToBeDocumented": ["Class", "Interface", "Function", "Method", "TypeAlias", "Variable"],
  "validation": {
    "notDocumented": true
  },
  "treatValidationWarningsAsErrors": true,
  "treatWarningsAsErrors": true
}
